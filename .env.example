# =============================================================================
# CareerOS AI — Master Cloud-Native Environment Configuration Template (.env)
# Copy this file to '.env' and populate sensitive credentials before deployment.
# NEVER commit raw '.env' files to source control!
# =============================================================================

# --- Environment & Profile Settings ---
# Options: local, dev, staging, prod
SPRING_PROFILES_ACTIVE=prod
VITE_APP_ENV=production
VITE_APP_TITLE=CareerOS AI Platform

# --- Network & Exposed Ports ---
PORT=8080
FRONTEND_PORT=80
POSTGRES_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# --- PostgreSQL Database Credentials & Connection Secrets ---
POSTGRES_DB=careeros_ai_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_change_me
DATABASE_URL=jdbc:postgresql://postgres:5432/careeros_ai_db

# --- Security & JWT Token Secrets ---
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# --- AI Engine & Grounded Provider Credentials ---
AI_PROVIDER_TYPE=LOCAL_GROUNDED
AI_PROVIDER_ENDPOINT=http://localhost:8080/api/v1/ai
AI_PROVIDER_API_KEY=sk_careeros_ai_demo_secret_key
